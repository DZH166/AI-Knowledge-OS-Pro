APP_ENV=development
DEMO_MODE=false
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Leave unset to use backend/data/knowledge_os.db.
# DATABASE_URL=sqlite:///./backend/data/knowledge_os.db
MAX_UPLOAD_SIZE_MB=25

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=5
QDRANT_COLLECTION_PREFIX=ai_knowledge_os

REDIS_URL=redis://localhost:6379/0
TASK_QUEUE_NAME=default
TASK_DEFAULT_PRIORITY=100
TASK_MAX_ATTEMPTS=3
TASK_TIMEOUT_SECONDS=1800
TASK_HEARTBEAT_TIMEOUT_SECONDS=120
WORKER_QUEUES=high,default,low

LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=2

# Optional HTTP reranker. Leave all three blank to use honest fusion-only retrieval.
RERANK_API_KEY=
RERANK_URL=
RERANK_MODEL=
RERANK_TIMEOUT_SECONDS=20
RERANK_MAX_RETRIES=2

OCR_PROVIDER=openai_compatible_vision
OCR_API_KEY=
OCR_BASE_URL=https://api.openai.com/v1
OCR_MODEL=gpt-4o-mini
OCR_TIMEOUT_SECONDS=120
OCR_MAX_RETRIES=2

TRANSCRIPTION_PROVIDER=openai_compatible_audio
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_TIMEOUT_SECONDS=300
TRANSCRIPTION_MAX_RETRIES=2

INDEX_VERSION=v2-openai-compatible-1536
RETRIEVAL_TOP_K=5
RETRIEVAL_DENSE_SCORE_THRESHOLD=0.15
RETRIEVAL_SCORE_THRESHOLD=0.15
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
